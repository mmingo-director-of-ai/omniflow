	<string>OmniFlow uses your approximate location only to show local weather in the island.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OmniFlow uses your microphone when you choose to talk. Speech is transcribed on your Mac.</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
